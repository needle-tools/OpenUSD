<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <position name="Position" type="vector3">
    <input name="space" type="string" value="world" />
  </position>
  <constant name="ReferencePoint" type="vector3">
    <input name="value" type="vector3" value="0,2,0" />
  </constant>
  <distance name="Distance" type="float">
    <input name="in1" type="vector3" nodename="Position" />
    <input name="in2" type="vector3" nodename="ReferencePoint" />
  </distance>
  <subtract name="Invert" type="float">
    <input name="in1" type="float" value="1" />
    <input name="in2" type="float" nodename="Distance" />
  </subtract>
  <convert name="Color" type="color3">
    <input name="in" type="float" nodename="Invert" />
  </convert>
  <UsdPreviewSurface name="Surface" type="surfaceshader">
    <input name="diffuseColor" type="color3" nodename="Color" />
    <input name="emissiveColor" type="color3" nodename="Color" />
    <input name="roughness" type="float" value="0.5" />
  </UsdPreviewSurface>
  <surfacematerial name="PositionMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Surface" />
  </surfacematerial>
</materialx>
