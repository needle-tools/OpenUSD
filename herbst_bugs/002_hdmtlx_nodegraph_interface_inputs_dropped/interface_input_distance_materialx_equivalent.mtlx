<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="Graph">
    <input name="center" type="vector3" value="0,100,0" />
    <position name="Position" type="vector3">
      <input name="space" type="string" value="model" />
    </position>
    <distance name="Distance" type="float">
      <input name="in1" type="vector3" nodename="Position" />
      <input name="in2" type="vector3" interfacename="center" />
    </distance>
    <multiply name="DistanceScale" type="float">
      <input name="in1" type="float" nodename="Distance" />
      <input name="in2" type="float" value="0.01" />
    </multiply>
    <convert name="DistanceColor" type="color3">
      <input name="in" type="float" nodename="DistanceScale" />
    </convert>
    <output name="out" type="color3" nodename="DistanceColor" />
  </nodegraph>
  <UsdPreviewSurface name="Surface" type="surfaceshader">
    <input name="diffuseColor" type="color3" nodegraph="Graph" output="out" />
    <input name="emissiveColor" type="color3" nodegraph="Graph" output="out" />
    <input name="roughness" type="float" value="0.5" />
  </UsdPreviewSurface>
  <surfacematerial name="DistanceMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Surface" />
  </surfacematerial>
</materialx>
