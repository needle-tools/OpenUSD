  <UsdPreviewSurface name="Surface" type="surfaceshader">
    <input name="diffuseColor" type="color3" output="diffuseColor_out" nodegraph="NG_Anonymized" />
    <input name="emissiveColor" type="color3" output="emissiveColor_out" nodegraph="NG_Anonymized" />
  </UsdPreviewSurface>
  <surfacematerial name="DistanceMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Surface" />
  </surfacematerial>
  <nodegraph name="NG_Anonymized">
    <convert name="N1NDconvertfloatcolor3emissiveColor" type="color3" nodedef="ND_convert_float_color3">
      <input name="in" type="float" nodename="N2NDmultiplyfloatin" />
    </convert>
    <multiply name="N2NDmultiplyfloatin" type="float" nodedef="ND_multiply_float">
      <input name="in1" type="float" nodename="N4NDdistancevector3in1" />
      <input name="in2" type="float" nodename="N3NDconstantfloatin2" />
    </multiply>
    <distance name="N4NDdistancevector3in1" type="float" nodedef="ND_distance_vector3">
      <input name="in1" type="vector3" nodename="N6NDpositionvector3in1" />
      <input name="in2" type="vector3" nodename="N5NDconstantvector3in2" />
    </distance>
    <position name="N6NDpositionvector3in1" type="vector3" nodedef="ND_position_vector3">
      <input name="space" type="string" value="model" />
    </position>
    <constant name="N5NDconstantvector3in2" type="vector3" nodedef="ND_constant_vector3">
      <input name="value" type="vector3" value="0, 100, 0" />
    </constant>
    <constant name="N3NDconstantfloatin2" type="float" nodedef="ND_constant_float">
      <input name="value" type="float" value="0.01" />
    </constant>
    <output name="diffuseColor_out" type="color3" nodename="N1NDconvertfloatcolor3emissiveColor" />
    <output name="emissiveColor_out" type="color3" nodename="N1NDconvertfloatcolor3emissiveColor" />
  </nodegraph>
</materialx>
